App(
    appid="telly_remote",
    name="Telly Remote",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="telly_remote_app",
    requires=["gui", "bt", "cli"],
    stack_size=2 * 1024,
    fap_libs=["ble_profile"],
    fap_category="Bluetooth",
    fap_description="BLE remote for Telly TV, driven over USB CLI",
    fap_version="0.1",
)

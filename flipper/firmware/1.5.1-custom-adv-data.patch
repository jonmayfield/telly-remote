diff --git a/targets/f7/ble_glue/gap.c b/targets/f7/ble_glue/gap.c
index 38fc5e4..8cf55f3 100644
--- a/targets/f7/ble_glue/gap.c
+++ b/targets/f7/ble_glue/gap.c
@@ -54,6 +54,27 @@ typedef enum {
 static Gap* gap = NULL;
 
 static void gap_advertise_start(GapState new_state);
+
+// Optional raw advertising / scan response payloads that replace the ones the
+// stack builds (lets an app mirror another device's advertisement exactly,
+// e.g. LE Limited Discoverable flags). Set via gap_set_custom_adv_data().
+static uint8_t gap_custom_adv[31];
+static uint8_t gap_custom_adv_len = 0;
+static uint8_t gap_custom_scan_rsp[31];
+static uint8_t gap_custom_scan_rsp_len = 0;
+
+void gap_set_custom_adv_data(
+    const uint8_t* adv,
+    uint8_t adv_len,
+    const uint8_t* scan_rsp,
+    uint8_t scan_rsp_len) {
+    if(adv_len > sizeof(gap_custom_adv)) adv_len = sizeof(gap_custom_adv);
+    if(scan_rsp_len > sizeof(gap_custom_scan_rsp)) scan_rsp_len = sizeof(gap_custom_scan_rsp);
+    if(adv_len) memcpy(gap_custom_adv, adv, adv_len);
+    if(scan_rsp_len) memcpy(gap_custom_scan_rsp, scan_rsp, scan_rsp_len);
+    gap_custom_adv_len = adv_len;
+    gap_custom_scan_rsp_len = scan_rsp_len;
+}
 static int32_t gap_app(void* context);
 
 static void gap_verify_connection_parameters(Gap* gap) {
@@ -467,6 +488,15 @@ static void gap_advertise_start(GapState new_state) {
         0);
     if(status) {
         FURI_LOG_E(TAG, "set_discoverable failed %d", status);
+    } else {
+        if(gap_custom_adv_len) {
+            status = hci_le_set_advertising_data(gap_custom_adv_len, gap_custom_adv);
+            if(status) FURI_LOG_E(TAG, "set_advertising_data failed %d", status);
+        }
+        if(gap_custom_scan_rsp_len) {
+            status = hci_le_set_scan_response_data(gap_custom_scan_rsp_len, gap_custom_scan_rsp);
+            if(status) FURI_LOG_E(TAG, "set_scan_response_data failed %d", status);
+        }
     }
     gap->state = new_state;
     GapEvent event = {.type = GapEventTypeStartAdvertising};
